{
  "name": "orbit",
  "private": true,
  "version": "2.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ios": "CAPACITOR=1 tsc -b && CAPACITOR=1 vite build",
    "cap:sync": "npm run build:ios && npx cap sync ios",
    "cap:sync:android": "npm run build:ios && npx cap sync android",
    "lint": "oxlint",
    "test": "vitest run && node --test scripts/emit-pages-legal.test.mjs scripts/ios-testflight.test.mjs scripts/parkmerke-boundary.test.mjs && node scripts/check-public-bundle.mjs",
    "preview": "vite preview",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "build:zip": "npm run build && node scripts/check-public-bundle.mjs && cp dist/index.html dist/404.html && bash scripts/emit-pages-legal.sh dist && cd dist && zip -r ../orbit-web.zip ."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-native-biometric": "^8.8.1",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.45.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.81.0",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "description": "Orbit — marketplace for everything"
}
