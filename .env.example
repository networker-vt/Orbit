# =============================================================================
# Orbit — marketplace for everything (Production Upload)
# Kopiere nach .env / .env.local. NIEMALS echte Keys committen.
# Service-Role-Key gehört NUR auf den Server — nie ins Frontend / VITE_*.
# =============================================================================

# --- Supabase (optional) ---
# Wenn URL + Anon-Key gültig gesetzt sind, bevorzugt die App Supabase
# (Hydrate + Write-Through). Credit-Mutationen in VITE_APP_MODE=prod ohne Keys
# hard-failen (kein stilles lokales Mint). Demo-Store gilt nur für VITE_APP_MODE=demo.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# true = erzwingt Demo-Hinweise in Doku; Store fällt ohnehin ohne Keys zurück
VITE_USE_MOCK=true

# demo = localStorage ledger + local auth. prod = Supabase credit_events + magic link
# (prod ohne Keys: Credit-Mutationen hard-fail, kein Demo-Mint).
VITE_APP_MODE=demo
# Alias (älter): VITE_ORBIT_MODE=demo

# --- Feature flags (production / Pages: see .env.production) ---
# VITE_FLAG_CREDITS=1  # Referral + Treuepunkte-Ledger (Demo, kein Cash-out)

# --- App ---
VITE_APP_NAME=Orbit
# Öffentliche Basis-URL (Pages oder Custom Domain) — für Docs / spätere Deep Links
VITE_APP_URL=https://networker-vt.github.io/orbit/

# Optional später:
# VITE_PLAUSIBLE_DOMAIN=
# VITE_SENTRY_DSN=

# --- Payments (MOCK ONLY) ---
# Wallet / Pay-Sheet sind reine UI-Stubs. Die App ruft KEINE PayPal-, Stripe-
# oder Krypto-APIs auf. Keys hier zu setzen ändert nichts — kein echtes Geld.
# --- Orbit Assist (optional LLM) ---
# Ohne Key: lokale Heuristik + ehrliche Demo-Recherche. Mit Key: kurze Tipps,
# Fallback bleibt lokal wenn der Request fehlschlägt.
# VITE_LLM_API_KEY=
# VITE_LLM_URL=https://api.openai.com/v1/chat/completions
# VITE_LLM_MODEL=gpt-4o-mini
