{
  "appId": "app.allda.companion",
  "appName": "Orbit",
  "webDir": "dist",
  "backgroundColor": "#F7F6F3",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "ios": {
    "backgroundColor": "#F7F6F3"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#F7F6F3",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F7F6F3"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
